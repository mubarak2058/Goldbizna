rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformOwner() {
      return signedIn() && request.auth.uid == "ZW5pqCx3FvSzxtXBiZMMC6fP5ro2";
    }

    function activeCompany(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.status == "active";
    }

    function activeMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + "_" + companyId))
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + "_" + companyId)).data.status == "active";
    }

    function companyManager(companyId) {
      return platformOwner() || (
        activeMember(companyId)
        && get(/databases/$(database)/documents/companyMemberships/$(request.auth.uid + "_" + companyId)).data.role in ["company_admin", "manager"]
      );
    }

    // TEMPORARY LEGACY ACCESS: retained to avoid breaking the existing POS
    // while its inventory client is migrated to companies/{companyId}/inventory.
    // This public rule is a known security exposure and must be removed after migration.
    match /inventory/{productId} {
      allow read, create, update, delete: if true;
    }

    match /settings/{settingId} {
      allow read, write: if platformOwner();
    }

    match /companies/{companyId} {
      allow read: if platformOwner() || activeMember(companyId);
      allow create, update, delete: if platformOwner();

      match /branches/{branchId} {
        allow read: if platformOwner() || (activeCompany(companyId) && activeMember(companyId));
        allow create, update, delete: if false; // Use validated callable functions.
      }

      match /sellerPaymentSettings/{sellerUid} {
        allow read: if platformOwner() || (activeCompany(companyId) && activeMember(companyId) && request.auth.uid == sellerUid);
        allow write: if false; // Only setSellerPaymentOptions may change seller settings.
      }

      // Tenant data is readable/writable only by active members of this company.
      // Writes to membership and payment-control records are server-only.
      match /{collectionName}/{documentId} {
        allow read, write: if activeCompany(companyId) && activeMember(companyId)
          && collectionName in ["inventory", "sales", "customers", "products", "stockMovements", "shifts", "cashups", "expenses", "suppliers"];
      }
    }

    match /companyMemberships/{membershipId} {
      allow read, write: if false; // Membership changes must use trusted callable functions.
    }

    match /platformAuditLogs/{logId} {
      allow read, write: if false; // Audit logs are server-only.
    }

    match /staffPresence/{presenceId} {
      allow read, write: if false; // Presence is managed through callable functions.
    }

    match /mpesaCodeRegistry/{codeId} {
      allow read, write: if false;
    }

    match /mpesaAlerts/{alertId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
